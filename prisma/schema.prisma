generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== MULTI-TENANT MODELS ==========

enum SubscriptionPlan {
  BASIC
  PROFESSIONAL
  ENTERPRISE

  @@map("subscription_plan")
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELED
  EXPIRED

  @@map("subscription_status")
}

model Business {
  id                String              @id @default(cuid())
  slug              String?             @unique
  name              String
  displayName       String?             @map("display_name")
  email             String              @unique
  phone             String?
  address           String?
  password          String
  subscriptionPlan  SubscriptionPlan    @default(BASIC)
  subscriptionStatus SubscriptionStatus @default(ACTIVE) @map("subscription_status")
  subscriptionStartDate DateTime?       @map("subscription_start_date")
  subscriptionEndDate DateTime?         @map("subscription_end_date")
  monthlyPrice      Decimal             @default(99.99) @db.Decimal(10, 2) @map("monthly_price")
  isActive          Boolean             @default(true) @map("is_active")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  planId            String?             @map("plan_id")
  
  // Branding e Identidade
  logoUrl           String?             @map("logo_url")
  faviconUrl        String?             @map("favicon_url")
  primaryColor      String?             @default("#3B82F6") @map("primary_color")
  secondaryColor    String?             @default("#1E40AF") @map("secondary_color")
  backgroundColor   String?             @default("#F9FAFB") @map("background_color")
  textColor         String?             @default("#1F2937") @map("text_color")
  themeMode         String?             @default("light") @map("theme_mode")
  
  // Contato
  contactWhatsapp   String?             @map("contact_whatsapp")
  contactPhone      String?             @map("contact_phone")
  contactAddress    String?             @map("contact_address")
  contactCity       String?             @map("contact_city")
  contactState      String?             @map("contact_state")
  contactZipcode    String?             @map("contact_zipcode")
  contactLatitude   Decimal?            @map("contact_latitude") @db.Decimal(10, 8)
  contactLongitude  Decimal?            @map("contact_longitude") @db.Decimal(11, 8)
  
  // Redes Sociais
  socialInstagram   String?             @map("social_instagram")
  socialFacebook    String?             @map("social_facebook")
  socialLinkedin    String?             @map("social_linkedin")
  
  // Políticas e Textos Legais
  termsOfService    String?             @map("terms_of_service")
  privacyPolicy     String?             @map("privacy_policy")
  lgpdMessage       String?             @map("lgpd_message")
  ctaText           String?             @default("Agende agora") @map("cta_text")
  footerText        String?             @map("footer_text")
  
  // Relacionamentos
  customers         Customer[]
  cars              Car[]
  services          Service[]
  categories        Category[]
  appointments      Appointment[]
  ratings           CustomerRating[]
  settings          BusinessSettings?
  packages          ServicePackage[]
  notificationTemplates NotificationTemplate[]
  notificationLogs  NotificationLog[]
  appointmentCancellations AppointmentCancellation[]
  users             User[]
  tenantSettings    TenantSettings?
  plan              Plan?               @relation(fields: [planId], references: [id])
  products          Product[]
  productCategories ProductCategory[]
  inventoryMovements InventoryMovement[]
  budgets           Budget[]
  financialAccounts FinancialAccount[]
  financialTransactions FinancialTransaction[]
  aiInsightLogs     AiInsightLog[]
  whatsappQueue     WhatsAppMessageQueue[]
  whatsappConversations WhatsAppConversation[]
  whatsappInboundMessages WhatsAppInboundMessage[]
  whatsappConfig    WhatsAppBusinessConfig?
  dilutionRecipes   DilutionRecipe[]
  dilutionBatches   DilutionBatch[]
  usageTemplates    ServiceProductUsageTemplate[]
  executionUsages   ServiceExecutionProductUsage[]

  @@map("businesses")
}

// Planos (Simples, Profissional, Completo) sem quebrar enum existente
model Plan {
  id              String   @id @default(cuid())
  code            String   @unique // SIMPLES, PROFISSIONAL, COMPLETO
  name            String
  description     String?
  maxUsers        Int?
  whatsappEnabled Boolean  @default(false)
  aiEnabled       Boolean  @default(false)
  monthlyQuoteLimit Int?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  businesses      Business[]

  @@map("plans")
}

model BusinessSettings {
  id                       String   @id @default(cuid())
  businessId               String   @unique @map("business_id")
  business                 Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  // Horário funcionamento
  openingTimeWeekday       String   @map("opening_time_weekday")
  closingTimeWeekday       String   @map("closing_time_weekday")
  slotIntervalMinutes      Int      @map("slot_interval_minutes")
  maxCarsPerSlot           Int      @map("max_cars_per_slot")
  timezone                 String   @default("America/Sao_Paulo")
  
  // Reputação
  reputationEnabled        Boolean  @default(true) @map("reputation_enabled")
  reputationAdvancePercent Int      @default(50) @map("reputation_advance_percent")
  reputationMinForAdvance  Decimal  @default(3.0) @map("reputation_min_for_advance") @db.Decimal(2, 1)
  reputationNoShowPenalty  Decimal  @default(2.5) @map("reputation_no_show_penalty") @db.Decimal(2, 1)
  reputationRecoveryOnShow Boolean  @default(true) @map("reputation_recovery_on_show")
  
  // Notificações
  notificationsEnabled     Boolean  @default(true) @map("notifications_enabled")
  notificationChannel      String   @default("email") @map("notification_channel") // email, sms, whatsapp
  notifyOn24hBefore       Boolean  @default(true) @map("notify_on_24h_before")
  notifyOn1hBefore        Boolean  @default(true) @map("notify_on_1h_before")
  
  // Pacotes
  packagesEnabled          Boolean  @default(true) @map("packages_enabled")
  
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("business_settings")
}

model Service {
  id                  String               @id @default(cuid())
  businessId          String               @map("business_id")
  business            Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  name                String
  description         String?
  durationMinutes     Int                  @map("duration_minutes")
  price               Decimal              @db.Decimal(10, 2)
  isActive            Boolean              @default(true) @map("is_active")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  serviceGroup        String?              @map("service_group")
  categoryId          String?              @map("category_id")
  
  category            Category?            @relation(fields: [categoryId], references: [id])
  appointmentServices AppointmentService[]
  packageServices     PackageService[]
  serviceProducts     ServiceProduct[]
  budgetItems         BudgetItem[]
  usageTemplates      ServiceProductUsageTemplate[]
  executionUsages     ServiceExecutionProductUsage[]

  @@unique([businessId, name])
  @@map("services")
}

model Category {
  id          String    @id @default(cuid())
  businessId  String    @map("business_id")
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  name        String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  services    Service[]

  @@unique([businessId, name])
  @@map("categories")
}

model Customer {
  id                  String        @id @default(cuid())
  businessId          String        @map("business_id")
  business            Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  name                String
  phone               String
  email               String?
  password            String?
  notes               String?
  isAdmin             Boolean       @default(false) @map("is_admin")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  completedCount      Int           @default(0) @map("completed_count")
  noShowCount         Int           @default(0) @map("no_show_count")
  rating              Decimal       @default(5.0) @db.Decimal(2, 1)
  googleId            String?       @unique @map("google_id")
  phoneVerified       Boolean       @default(false) @map("phone_verified")
  verificationCode    String?       @map("verification_code")
  verificationExpiry  DateTime?     @map("verification_expiry")
  
  appointments        Appointment[]
  cars                Car[]
  ratings             CustomerRating[]
  notificationLogs    NotificationLog[]
  budgets             Budget[]
  whatsappQueue       WhatsAppMessageQueue[]

  @@unique([businessId, phone])
  @@unique([businessId, email])
  @@map("customers")
}

model Car {
  id           String        @id @default(cuid())
  businessId   String        @map("business_id")
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId   String        @map("customer_id")
  
  plate        String
  model        String
  color        String?
  year         Int?
  vehicleType  VehicleType   @default(HATCH) @map("vehicle_type")
  notes        String?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  
  appointments Appointment[]
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  executionUsages ServiceExecutionProductUsage[]

  @@unique([businessId, plate])
  @@map("cars")
}

enum VehicleType {
  HATCH
  SEDAN
  SUV
  PICKUP
  MOTO
  VAN

  @@map("vehicle_type")
}

model Appointment {
  id                    String               @id @default(cuid())
  businessId            String               @map("business_id")
  business              Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId            String               @map("customer_id")
  carId                 String               @map("car_id")
  
  startDatetime         DateTime             @map("start_datetime")
  endDatetime           DateTime             @map("end_datetime")
  status                AppointmentStatus    @default(PENDING)
  totalPrice            Decimal              @map("total_price") @db.Decimal(10, 2)
  notes                 String?
  businessNotes         String?              @map("business_notes")
  suggestedDatetime     DateTime?            @map("suggested_datetime")
  confirmedByClientAt   DateTime?            @map("confirmed_by_client_at")
  confirmedByBusinessAt DateTime?            @map("confirmed_by_business_at")
  finalizedAt           DateTime?            @map("finalized_at")
  inventoryWrittenOff   Boolean              @default(false) @map("inventory_written_off")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  
  appointmentServices   AppointmentService[]
  inventoryMovements    InventoryMovement[]
  financialTransactions FinancialTransaction[]
  cancellation          AppointmentCancellation?
  car                   Car                  @relation(fields: [carId], references: [id])
  customer              Customer             @relation(fields: [customerId], references: [id])
  executionUsages       ServiceExecutionProductUsage[]

  @@index([businessId, startDatetime])
  @@index([businessId, status])
  @@map("appointments")
}

model AppointmentService {
  id            String      @id @default(cuid())
  appointmentId String      @map("appointment_id")
  serviceId     String      @map("service_id")
  price         Decimal     @db.Decimal(10, 2)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service       Service     @relation(fields: [serviceId], references: [id])

  @@map("appointment_services")
}

// ========== CATEGORIAS DE PRODUTOS ==========
model ProductCategory {
  id          String    @id @default(cuid())
  businessId  String    @map("business_id")
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  name        String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  products    Product[]

  @@unique([businessId, name])
  @@map("product_categories")
}

// ========== PRODUTOS (COM SUPORTE A DILUIÇÃO) ==========
model Product {
  id            String   @id @default(cuid())
  businessId    String   @map("business_id")
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId    String?  @map("category_id")
  category      ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  name          String
  brand         String?
  sku           String?  @unique
  
  // Campos legados (manter compatibilidade)
  unit          String   @default("un")
  cost          Decimal  @db.Decimal(10, 2)
  currentStock  Int      @default(0) @map("current_stock")
  minStock      Int      @default(0) @map("min_stock")
  
  // Novos campos para diluição
  isConcentrated Boolean @default(false) @map("is_concentrated")
  baseUnit      String   @default("ml") @map("base_unit") // 'ml', 'g', 'unit'
  packageSizeMl Int      @default(0) @map("package_size_ml")
  costTotal     Decimal  @default(0) @db.Decimal(12, 2) @map("cost_total")
  stockMinMl    Int      @default(0) @map("stock_min_ml")
  
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  movements        InventoryMovement[]
  serviceProducts  ServiceProduct[]
  dilutionRecipes  DilutionRecipe[]
  usageTemplates   ServiceProductUsageTemplate[]
  executionUsages  ServiceExecutionProductUsage[]

  @@unique([businessId, name])
  @@index([businessId, categoryId])
  @@map("products")
}

enum InventoryMovementType {
  IN
  OUT
  ADJUST
  MANUAL_OUT
  SERVICE_OUT
  DILUTION
  TRANSFER

  @@map("inventory_movement_type")
}

model InventoryMovement {
  id            String   @id @default(cuid())
  businessId    String   @map("business_id")
  productId     String   @map("product_id")
  appointmentId String?  @map("appointment_id")
  budgetId      String?  @map("budget_id")

  movementType  InventoryMovementType @map("movement_type")
  quantity      Decimal  @db.Decimal(10, 3)
  unitCost      Decimal? @db.Decimal(10, 2) @map("unit_cost")
  
  // Novos campos para referência genérica
  referenceType String?  @map("reference_type") // 'PURCHASE', 'DILUTION_BATCH', 'SERVICE_EXECUTION', 'MANUAL'
  referenceId   String?  @map("reference_id")
  createdByUserId String? @map("created_by_user_id")
  
  note          String?
  createdAt     DateTime @default(now()) @map("created_at")

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  budget        Budget?  @relation(fields: [budgetId], references: [id])
  createdByUser User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([businessId, productId])
  @@index([referenceType, referenceId])
  @@index([businessId, createdAt])
  @@map("inventory_movements")
}

// Produtos consumidos por serviço
model ServiceProduct {
  id         String   @id @default(cuid())
  serviceId  String   @map("service_id")
  productId  String   @map("product_id")
  quantity   Decimal  @db.Decimal(10, 3)

  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([serviceId, productId])
  @@map("service_products")
}

// Orçamentos (propostas)
enum BudgetStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  CONVERTED

  @@map("budget_status")
}

model Budget {
  id            String   @id @default(cuid())
  businessId    String   @map("business_id")
  customerId    String   @map("customer_id")
  status        BudgetStatus @default(DRAFT)
  total         Decimal  @db.Decimal(10, 2)
  expiresAt     DateTime? @map("expires_at")
  notes         String?
  publicToken   String   @unique @map("public_token")
  signedAt      DateTime? @map("signed_at")
  signedByName  String?  @map("signed_by_name")
  signedByIp    String?  @map("signed_by_ip")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items         BudgetItem[]
  signatures    BudgetSignature[]
  inventoryMovements InventoryMovement[]
  financialTransactions FinancialTransaction[]

  @@index([businessId, status])
  @@map("budgets")
}

model BudgetItem {
  id         String   @id @default(cuid())
  budgetId   String   @map("budget_id")
  serviceId  String?  @map("service_id")

  name       String
  description String?
  quantity   Decimal  @db.Decimal(10, 3)
  unitPrice  Decimal  @db.Decimal(10, 2) @map("unit_price")
  total      Decimal  @db.Decimal(10, 2)

  budget     Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  service    Service? @relation(fields: [serviceId], references: [id])

  @@map("budget_items")
}

model BudgetSignature {
  id         String   @id @default(cuid())
  budgetId   String   @map("budget_id")
  signerName String   @map("signer_name")
  signatureData String @map("signature_data")
  signerIp   String?  @map("signer_ip")
  signedAt   DateTime @default(now()) @map("signed_at")

  budget     Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@map("budget_signatures")
}

// Financeiro
enum FinancialAccountType {
  REVENUE
  EXPENSE
  ASSET
  LIABILITY
  EQUITY

  @@map("financial_account_type")
}

model FinancialAccount {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  name        String
  type        FinancialAccountType
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactions FinancialTransaction[]

  @@unique([businessId, name])
  @@map("financial_accounts")
}

enum FinancialTransactionType {
  REVENUE
  EXPENSE

  @@map("financial_transaction_type")
}

enum FinancialTransactionStatus {
  PENDING
  CLEARED

  @@map("financial_transaction_status")
}

model FinancialTransaction {
  id            String   @id @default(cuid())
  businessId    String   @map("business_id")
  accountId     String   @map("account_id")
  appointmentId String?  @map("appointment_id")
  budgetId      String?  @map("budget_id")
  type          FinancialTransactionType
  status        FinancialTransactionStatus @default(PENDING)
  amount        Decimal  @db.Decimal(12, 2)
  occurredAt    DateTime @default(now()) @map("occurred_at")
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  account       FinancialAccount @relation(fields: [accountId], references: [id])
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  budget        Budget?    @relation(fields: [budgetId], references: [id])

  @@index([businessId, type])
  @@map("financial_transactions")
}

// IA Insights
model AiInsightLog {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  userId      String?  @map("user_id")
  prompt      String
  response    String?
  latencyMs   Int?     @map("latency_ms")
  costUsd     Decimal? @db.Decimal(10, 4) @map("cost_usd")
  createdAt   DateTime @default(now()) @map("created_at")

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@map("ai_insight_logs")
}

// Fila de WhatsApp
enum WhatsAppMessageStatus {
  PENDING
  SENT
  FAILED

  @@map("whatsapp_message_status")
}

model WhatsAppMessageQueue {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  customerId  String?  @map("customer_id")
  phone       String
  templateKey String   @map("template_key")
  payload     Json     @default("{}")
  status      WhatsAppMessageStatus @default(PENDING)
  scheduledAt DateTime? @map("scheduled_at")
  sentAt      DateTime? @map("sent_at")
  error       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  conversationId String? @map("conversation_id")
  inboundMessageId String? @map("inbound_message_id")
  retryCount  Int      @default(0) @map("retry_count")
  nextAttemptAt DateTime? @map("next_attempt_at")

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer    Customer? @relation(fields: [customerId], references: [id])
  conversation WhatsAppConversation? @relation(fields: [conversationId], references: [id])

  @@index([businessId, status])
  @@index([businessId, conversationId])
  @@map("whatsapp_message_queue")
}

enum WhatsAppConversationStatus {
  ACTIVE
  INACTIVE
  AWAITING_RESPONSE

  @@map("whatsapp_conversation_status")
}

model WhatsAppConversation {
  id                String   @id @default(cuid())
  businessId        String   @map("business_id")
  customerPhone     String   @map("customer_phone")
  customerId        String?  @map("customer_id")
  lastCustomerMessageAt DateTime? @map("last_customer_message_at")
  stateJson         Json     @default("{}") @map("state_json")
  status            WhatsAppConversationStatus @default(ACTIVE)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  inboundMessages   WhatsAppInboundMessage[]
  queueMessages     WhatsAppMessageQueue[]

  @@unique([businessId, customerPhone])
  @@index([businessId, status])
  @@map("whatsapp_conversations")
}

model WhatsAppInboundMessage {
  id              String   @id @default(cuid())
  businessId      String   @map("business_id")
  conversationId  String   @map("conversation_id")
  fromPhone       String   @map("from_phone")
  text            String
  receivedAt      DateTime @map("received_at")
  rawJson         Json     @default("{}") @map("raw_json")
  waMessageId     String?  @map("wa_message_id")
  createdAt       DateTime @default(now()) @map("created_at")

  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation    WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([businessId, conversationId])
  @@index([businessId, receivedAt])
  @@map("whatsapp_inbound_messages")
}

model WhatsAppBusinessConfig {
  id              String  @id @default(cuid())
  businessId      String  @unique @map("business_id")
  phoneNumberId   String  @map("phone_number_id")
  accessToken     String  @map("access_token")
  displayName     String? @map("display_name")
  appSecret       String? @map("app_secret")
  isActive        Boolean @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([isActive])
  @@map("whatsapp_business_config")
}

model Settings {
  id                       String   @id @default(cuid())
  openingTimeWeekday       String   @map("opening_time_weekday")
  closingTimeWeekday       String   @map("closing_time_weekday")
  slotIntervalMinutes      Int      @map("slot_interval_minutes")
  maxCarsPerSlot           Int      @map("max_cars_per_slot")
  timezone                 String   @default("America/Sao_Paulo")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")
  reputationAdvancePercent Int      @default(50) @map("reputation_advance_percent")
  reputationEnabled        Boolean  @default(true) @map("reputation_enabled")
  reputationMinForAdvance  Decimal  @default(3.0) @map("reputation_min_for_advance") @db.Decimal(2, 1)
  reputationNoShowPenalty  Decimal  @default(2.5) @map("reputation_no_show_penalty") @db.Decimal(2, 1)
  reputationRecoveryOnShow Boolean  @default(true) @map("reputation_recovery_on_show")

  @@map("settings")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED_BY_CLIENT
  CONFIRMED
  RESCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELED
  NO_SHOW

  @@map("appointment_status")
}

// ========== NOVOS MODELOS PARA FUNCIONALIDADES ==========

model ServicePackage {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  name        String
  description String?
  discountPercent Decimal @db.Decimal(5, 2) @map("discount_percent")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  services    PackageService[]

  @@unique([businessId, name])
  @@map("service_packages")
}

model PackageService {
  id        String   @id @default(cuid())
  packageId String   @map("package_id")
  serviceId String   @map("service_id")
  
  package   ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service   Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([packageId, serviceId])
  @@map("package_services")
}

model AppointmentCancellation {
  id            String   @id @default(cuid())
  businessId    String   @map("business_id")
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointmentId String   @unique @map("appointment_id")
  
  reason        String   // motivo do cancelamento
  canceledBy    String   @map("canceled_by") // 'customer' ou 'business'
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("appointment_cancellations")
}

model CustomerRating {
  id           String   @id @default(cuid())
  businessId   String   @map("business_id")
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId   String   @map("customer_id")
  
  rating       Decimal  @db.Decimal(2, 1)
  comment      String?
  createdAt    DateTime @default(now()) @map("created_at")
  
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_ratings")
}

enum NotificationTemplateType {
  APPOINTMENT_CREATED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_24H_REMINDER
  APPOINTMENT_1H_REMINDER
  APPOINTMENT_COMPLETED
  // WhatsApp Cloud API UTILITY templates (24h window)
  APPOINTMENT_CONFIRMATION_UTILITY
  APPOINTMENT_REMINDER_UTILITY
  REOPEN_CONVERSATION_UTILITY

  @@map("notification_template_type")
}

model NotificationTemplate {
  id        String                   @id @default(cuid())
  businessId String                  @map("business_id")
  business  Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  type      NotificationTemplateType
  title     String
  body      String
  isActive  Boolean                  @default(true) @map("is_active")
  createdAt DateTime                 @default(now()) @map("created_at")
  updatedAt DateTime                 @updatedAt @map("updated_at")

  @@unique([businessId, type])
  @@map("notification_templates")
}

model NotificationLog {
  id           String   @id @default(cuid())
  businessId   String   @map("business_id")
  customerId   String?  @map("customer_id")
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  type         String
  channel      String   // email, sms, whatsapp
  recipient    String   // email ou telefone
  subject      String?
  body         String
  sentAt       DateTime @default(now()) @map("sent_at")
  status       String   @default("pending") // pending, sent, failed
  errorMessage String?  @map("error_message")

  @@index([businessId, sentAt])
  @@map("notification_logs")
}
// ========== USER E CONFIGURAÇÕES MULTI-TENANT ==========

enum UserRole {
  OWNER
  STAFF
  CUSTOMER

  @@map("user_role")
}

model User {
  id                String    @id @default(cuid())
  businessId        String    @map("business_id")
  business          Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  email             String
  password          String
  fullName          String    @map("full_name")
  phone             String?
  role              UserRole  @default(STAFF)
  isActive          Boolean   @default(true) @map("is_active")
  
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  
  inventoryMovements InventoryMovement[]
  dilutionBatches   DilutionBatch[]

  @@unique([businessId, email])
  @@index([businessId, role])
  @@index([businessId, isActive])
  @@map("users")
}

model TenantSettings {
  id                String    @id @default(cuid())
  businessId        String    @unique @map("business_id")
  business          Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  // Configurações JSON para máxima flexibilidade
  brandingConfig    Json      @default("{}") @map("branding_config")
  hoursConfig       Json      @default("{}") @map("hours_config")
  capacityConfig    Json      @default("{}") @map("capacity_config")
  cardsConfig       Json      @default("{}") @map("cards_config")
  contactConfig     Json      @default("{}") @map("contact_config")
  notificationConfig Json      @default("{}") @map("notification_config")
  
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([businessId])
  @@map("tenant_settings")
}// ========== SISTEMA DE DILUIÃ‡ÃƒO E CONSUMO DINÃ‚MICO ==========

// Receitas de diluiÃ§Ã£o (ex: 1:10, 1:20)
model DilutionRecipe {
  id             String   @id @default(cuid())
  businessId     String   @map("business_id")
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId      String   @map("product_id")
  product        Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  
  name           String   // ex: "Lavagem Pesada (1:10)"
  ratioProduct   Int      @map("ratio_product") // ex: 1
  ratioWater     Int      @map("ratio_water")   // ex: 10
  targetBottleMl Int      @map("target_bottle_ml") @default(1000) // tamanho padrÃ£o do frasco
  isActive       Boolean  @default(true) @map("is_active")
  
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  
  batches        DilutionBatch[]
  usageTemplates ServiceProductUsageTemplate[]
  executionUsages ServiceExecutionProductUsage[]

  @@unique([businessId, productId, name])
  @@index([businessId, productId])
  @@map("dilution_recipes")
}

// Lotes de diluiÃ§Ã£o preparados
model DilutionBatch {
  id                String   @id @default(cuid())
  businessId        String   @map("business_id")
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recipeId          String   @map("recipe_id")
  recipe            DilutionRecipe @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  
  preparedTotalMl   Int      @map("prepared_total_ml")
  usedConcentrateMl Int      @map("used_concentrate_ml")
  usedWaterMl       Int      @map("used_water_ml")
  notes             String?
  
  // Snapshot da receita no momento do preparo (para detectar alterações posteriores)
  recipeNameSnapshot        String?  @map("recipe_name_snapshot")
  ratioProductSnapshot      Float?   @map("ratio_product_snapshot")
  ratioWaterSnapshot        Float?   @map("ratio_water_snapshot")
  targetBottleMlSnapshot    Int?     @map("target_bottle_ml_snapshot")
  
  createdByUserId   String?  @map("created_by_user_id")
  createdByUser     User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([businessId, createdAt])
  @@index([recipeId])
  @@map("dilution_batches")
}

// Templates de consumo por serviÃ§o + tipo de veÃ­culo
model ServiceProductUsageTemplate {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId   String   @map("service_id")
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  vehicleType VehicleType @map("vehicle_type")
  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  recipeId    String?  @map("recipe_id")
  recipe      DilutionRecipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  
  quantityMl  Int      @map("quantity_ml") // quantidade da soluÃ§Ã£o aplicada
  notes       String?
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([businessId, serviceId, vehicleType, productId, recipeId])
  @@index([businessId, serviceId])
  @@index([businessId, vehicleType])
  @@map("service_product_usage_templates")
}

// Consumo REAL de produtos quando serviÃ§o Ã© executado
model ServiceExecutionProductUsage {
  id           String      @id @default(cuid())
  businessId   String      @map("business_id")
  business     Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointmentId String     @map("appointment_id")
  appointment  Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId    String      @map("service_id")
  service      Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  carId        String?     @map("car_id")
  car          Car?        @relation(fields: [carId], references: [id], onDelete: SetNull)
  vehicleType  VehicleType @map("vehicle_type")
  productId    String      @map("product_id")
  product      Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  recipeId     String?     @map("recipe_id")
  recipe       DilutionRecipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  
  quantityMl   Int         @map("quantity_ml") // quantidade da soluÃ§Ã£o usada
  source       String      @default("TEMPLATE") // 'TEMPLATE' ou 'MANUAL'
  
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([appointmentId])
  @@index([businessId, serviceId])
  @@index([businessId, productId, createdAt])
  @@map("service_execution_product_usage")
}
