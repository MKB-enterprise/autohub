# Environment vars para testes
# Usar: docker-compose -f docker-compose.test.yml up -d
# Depois: export $(cat .env.test | xargs) && npm test

NODE_ENV=test
NEXT_PUBLIC_API_URL=http://localhost:3000
JWT_SECRET=test-secret-key-very-secret-change-in-production
DATABASE_URL=postgresql://test:test@localhost:5433/autohub_test
DATABASE_URL_TEST=postgresql://test:test@localhost:5433/autohub_test
PRISMA_DATABASE_URL=postgresql://test:test@localhost:5433/autohub_test
