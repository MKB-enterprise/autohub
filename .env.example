# Database URL (PostgreSQL)
# Exemplo para Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
# Exemplo para Railway: postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/railway
DATABASE_URL="postgresql://postgres:password@localhost:5432/estetica_automotiva"

# Timezone da aplicação
NEXT_PUBLIC_TIMEZONE="America/Sao_Paulo"

# JWT Secret (gere uma string aleatória segura)
JWT_SECRET="seu-secret-super-seguro-aqui-mude-isso"

# --- IA (Anthropic) ---
# Cadastre em https://console.anthropic.com/account/keys
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY="sk-ant-xxxxx"
# Modelo sugerido para respostas curtas
AI_MODEL="claude-3-5-sonnet-20241022"

# --- WhatsApp Cloud API (Meta) ---
# Configurar no WhatsApp Cloud / Graph API: https://developers.facebook.com/apps/
WHATSAPP_VERIFY_TOKEN="seu_token_de_verificacao_webhook"
META_WA_ACCESS_TOKEN="EAAB..."  # token de acesso da app
META_WA_PHONE_NUMBER_ID="123456789012345" # phone_number_id do número configurado
META_WA_APP_SECRET="app_secret_opcional" # recomendado para assinatura de webhook

# --- URLs públicas ---
# Base externa para webhooks (Vercel/produção ou tunel em dev)
PUBLIC_BASE_URL="http://localhost:3000"

# --- Cron ---
# Usado para proteger /api/cron/process-whatsapp-queue
CRON_SECRET="defina-um-segredo-forte"
